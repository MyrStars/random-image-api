# 服务端口
PORT=3100

# 管理员账号
ADMIN_USER=admin
# ⚠️ 生产环境务必修改密码！
ADMIN_PASS=your_secure_password_here

# JWT密钥
# ⚠️ 生产环境务必修改！生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# 存储密钥加密密钥（32位hex，16字节）
# ⚠️ 生产环境务必修改！生成方式: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ⚠️ 修改此值会导致已有存储源密钥无法解密！更换前请先删除所有存储源
ENCRYPT_KEY=0123456789abcdef

# 数据库文件路径
DB_PATH=./data/images.db

# 公开访问地址（用于生成API地址和管理后台显示）
PUBLIC_URL=http://localhost:3100

# CORS允许的来源（逗号分隔，* 表示全部允许，生产环境建议限制）
CORS_ORIGINS=*
